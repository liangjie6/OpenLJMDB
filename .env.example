# OpenLJMDB 运行环境变量配置示例
# 复制该文件为 .env 并填入实际值：cp .env.example .env

# 分类服务配置
LJMDB_DECISION_BASE_URL="https://your-classifier.example.com"
LJMDB_DECISION_API_KEY="sk-your-key-here"

# 监听配置（可选，程序默认 127.0.0.1:8080；systemd 部署模板使用 --port 19955）
LJMDB_HOST="127.0.0.1"
LJMDB_PORT="8080"

# 数据目录（可选，不设置时使用系统用户数据目录）
# LJMDB_DATA_DIR="/absolute/path/to/OpenLJMDB-data"
